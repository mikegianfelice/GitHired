# Copy to .env and fill in. Never commit .env.
# Discovery and deterministic ranking work with no API keys.

# Database
JOBSEEK_DB_PATH=data/jobseek.db
# GITHIRED_DB_PATH=data/jobseek.db

# Config directory (defaults to ./config then packaged defaults)
JOBSEEK_CONFIG_DIR=config

# Optional Stage-2 LLM ranking (githired rank --llm)
GITHIRED_RANK_LLM=0
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Optional paid LinkedIn search-index (free search + import-alerts work without this)
SERPAPI_KEY=

# Email digest — SMTP (primary)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Email digest — Resend (used when RESEND_API_KEY is set)
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Logging
JOBSEEK_LOG_LEVEL=INFO
